# NEXORA Backend Environment Configuration
# Copy to backend/.env (never commit .env with real values)

# ============================================================
# CORE SECURITY
# ============================================================
NER_SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_32_CHARS

# ============================================================
# DATABASE
# ============================================================
# Local development (SQLite):
# DATABASE_URL=sqlite:///./data/ner-smartlogix.db
# Production (Supabase PostgreSQL):
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# ============================================================
# SUPABASE (production only — leave empty for local dev)
# ============================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=citizen-evidence

# ============================================================
# CORS — set to your actual Vercel frontend URL
# ============================================================
FRONTEND_ORIGIN=https://your-nexora-app.vercel.app

# ============================================================
# SERVER
# ============================================================
ENVIRONMENT=production
# PORT is provided by Render automatically — do NOT set in Render env vars

# ============================================================
# AI (optional — rule-based fallback used when absent)
# ============================================================
GEMINI_API_KEY=

# ============================================================
# WEATHER (optional — Open-Meteo free fallback used when absent)
# ============================================================
OPENWEATHER_API_KEY=

# ============================================================
# GOOGLE MAPS (optional — OSM/MapLibre used on frontend when absent)
# ============================================================
GOOGLE_MAPS_API_KEY=

# ============================================================
# SACHET NDMA (official CAP XML feed — do NOT change URLs)
# ============================================================
SACHET_CAP_URL=https://sachet.ndma.gov.in/cap_public_website/FetchXMLFile
SACHET_NDMA_BASE_URL=https://sachet.ndma.gov.in/cap_public_website/FetchXMLFile
SACHET_ALERT_INDEX_URL=https://sachet.ndma.gov.in/cap_public_website/FetchAllAlertDetails
SACHET_LISTING_URL=https://sachet.ndma.gov.in/cap_public_website/FetchAllAlertDetails
SACHET_POLL_INTERVAL_SEC=300
SACHET_REQUEST_TIMEOUT=15

# ============================================================
# COMMUNICATION (set to simulation for SIH demo)
# ============================================================
SMS_PROVIDER=simulation
SATELLITE_PROVIDER=simulation

# ============================================================
# ADMIN BOOTSTRAP (optional — fill in to auto-create admin on first startup)
# ============================================================
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=
# ADMIN_STATE=All
# ADMIN_PHONE=
