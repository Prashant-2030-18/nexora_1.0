# ============================================================
# NEXORA — .gitignore
# Generated for SIH26002 zero-cost production deployment
# ============================================================

# ---- Environment files (NEVER commit real credentials) ----
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production
backend/.env
frontend/.env
frontend/.env.local
frontend/.env.production.local

# ---- SQLite databases (local dev only) ----
*.db
*.sqlite
*.sqlite3
data/*.db

# ---- Uploaded citizen evidence (use Supabase Storage in production) ----
uploads/
backend/uploads/

# ---- Python ----
__pycache__/
*.py[cod]
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
ENV/
.venv/
pip-log.txt
pip-delete-this-directory.txt
.eggs/
dist/
build/
*.egg-info/
*.egg

# ---- Node / frontend ----
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini

# ---- IDE ----
.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---- Render / deployment artifacts ----
.render/

# ---- Misc ----
*.log
*.tmp
