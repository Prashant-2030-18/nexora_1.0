{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://nexora-api-bybb.onrender.com/api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "https://nexora-api-bybb.onrender.com/uploads/$1"
    },
    {
      "source": "/health/(.*)",
      "destination": "https://nexora-api-bybb.onrender.com/health/$1"
    },
    {
      "source": "/health",
      "destination": "https://nexora-api-bybb.onrender.com/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ]
}
