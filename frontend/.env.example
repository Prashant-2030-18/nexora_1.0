# NEXORA Frontend Environment Configuration
# Copy to frontend/.env.local (never commit .env.local with real values)

# ============================================================
# API — backend URL
# ============================================================
# Local development: leave empty (Vite proxy to localhost:8000 handles it)
# Production: set to your Render backend URL
VITE_API_BASE_URL=

# ============================================================
# GOOGLE MAPS (optional — MapLibre/Leaflet used when absent/false)
# ============================================================
VITE_GOOGLE_MAPS_API_KEY=
VITE_ENABLE_GOOGLE_MAPS=false

# ============================================================
# DEMO/SIH FLAGS
# ============================================================
VITE_ENABLE_DEMO_COMMUNICATION=true

# ============================================================
# NOTE: Do NOT add secrets here.
# All VITE_* variables are publicly visible in the browser bundle.
# Backend secrets (DATABASE_URL, JWT, Supabase service role, AI keys)
# must ONLY be in the backend/.env.
# ============================================================
