# NER-SmartLogix / NEXORA Environment Variables
NER_SECRET_KEY=sih-mdoner-ner-smartlogix-super-secure-key-2026
ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1

# AI (optional)
GEMINI_API_KEY=

# Weather (optional — Open-Meteo used as fallback)
OPENWEATHER_API_KEY=

# Google Maps Platform (optional — frontend uses OSM when unset)
GOOGLE_MAPS_API_KEY=

# SACHET NDMA CAP XML
SACHET_CAP_URL=https://sachet.ndma.gov.in/cap_public_website/FetchXMLFile
SACHET_NDMA_BASE_URL=https://sachet.ndma.gov.in/cap_public_website/FetchXMLFile
# Official alert listing / index (required to discover identifiers — do not invent IDs)
SACHET_ALERT_INDEX_URL=https://sachet.ndma.gov.in/cap_public_website/FetchAllAlertDetails
SACHET_LISTING_URL=https://sachet.ndma.gov.in/cap_public_website/FetchAllAlertDetails
SACHET_POLL_INTERVAL_SEC=300
SACHET_REQUEST_TIMEOUT=15
SACHET_MAX_RETRIES=3

# Admin bootstrap (optional)
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=
# ADMIN_STATE=All
